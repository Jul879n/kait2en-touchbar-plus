        if base.is_dir():
            return base
    return None


# --- Qt Quick UI -----------------------------------------------------------

def desktop_apps():
    """Installed applications as [{id, name}], read from the .desktop files."""
    found = {}
    data_home = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
    # XDG precedence, like AppIcons.load: the user's directory first, then the system ones; the first file wins.
    dirs = [data_home] + [Path(d) for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
    for base in dirs:
        for path in (base / "applications").glob("*.desktop"):
            name, hidden = None, False
            try:
                for line in path.read_text(encoding="utf-8", errors="replace").splitlines():
                    if line.startswith("[") and line.strip() != "[Desktop Entry]":
                        break
                    if line.startswith("Name=") and name is None:
                        name = line[5:].strip()
                    elif line.strip() in ("NoDisplay=true", "Hidden=true"):
                        hidden = True
            except OSError:
                continue
            if name and not hidden:
                found.setdefault(path.name, name)
    return sorted(({"id": k, "name": v} for k, v in found.items()), key=lambda a: a["name"].lower())


def main():
    from PyQt6.QtCore import QByteArray, QObject, QSize, Qt, QTimer, QUrl, pyqtSignal, pyqtSlot
    from PyQt6.QtGui import QColor, QGuiApplication, QImage, QPainter
    from PyQt6.QtQml import QQmlApplicationEngine
    from PyQt6.QtQuick import QQuickImageProvider
    from PyQt6.QtSvg import QSvgRenderer

    directory = icon_dir()

    class Lucide(QQuickImageProvider):
        """image://lucide/<name>/<rrggbb>: a Lucide icon in the given color."""

        def __init__(self):
            super().__init__(QQuickImageProvider.ImageType.Image)
            self.cache = {}

        def requestImage(self, ident, requested):
            name, _sep, color = ident.partition("/")
            if "/" in name or ".." in name or "\\" in name:  # never leave the icon directory
                name = ""
            side = max(requested.width(), 24) if requested.isValid() else 24
            key = (name, color, side)
            if key not in self.cache:
                image = QImage(side, side, QImage.Format.Format_ARGB32_Premultiplied)
                image.fill(Qt.GlobalColor.transparent)
                path = directory / f"{name}.svg" if directory else None
                if path and path.exists():
                    svg = path.read_text(encoding="utf-8").replace("currentColor", "#" + (color or "dce6ff"))
                    painter = QPainter(image)
                    QSvgRenderer(QByteArray(svg.encode())).render(painter)
                    painter.end()
                self.cache[key] = image
            image = self.cache[key]
            return image, image.size()

    class AppIcons(QQuickImageProvider):
        """image://appicon/<id>.desktop: the real icon of an application."""

        def __init__(self):
            super().__init__(QQuickImageProvider.ImageType.Image)
            self.cache = {}

        def requestImage(self, ident, requested):
            side = max(requested.width(), 24) if requested.isValid() else 48
            if not ident.endswith(".desktop") or "/" in ident or " " in ident:
                ident = ""
            key = (ident, side)
            if key not in self.cache:
                self.cache[key] = self.load(ident, side)
            image = self.cache[key]
            return image, image.size()

        @staticmethod
        def find(name, side, dirs):
            """File of a themed icon: the smallest hicolor size that is at least `side`, else the largest."""
            found = []
            for base in dirs:
                for path in (base / "icons/hicolor").glob(f"*/apps/{name}.*"):
                    size = path.parent.parent.name.split("@")[0].split("x")[0]
                    found.append((10_000 if size == "scalable" else int(size) if size.isdigit() else 0, str(path)))
                found += [(0, str(p)) for p in (base / "pixmaps").glob(f"{name}.*")]
            fit = sorted(f for f in found if f[0] >= side)
            return (fit[0] if fit else max(found, default=(0, "")))[1]

        @staticmethod
        def load(ident, side):
            from PyQt6.QtGui import QIcon
            name = ""
            data_home = Path(os.environ.get("XDG_DATA_HOME", HOME / ".local/share"))
            dirs = [data_home] + [Path(d) for d in os.environ.get("XDG_DATA_DIRS", "/usr/local/share:/usr/share").split(":")]
            for base in dirs if ident else []:
                try:
                    for line in (base / "applications" / ident).read_text(encoding="utf-8", errors="replace").splitlines():
                        if line.startswith("Icon="):
                            name = line[5:].strip()
                            break
                except OSError:
                    continue
                if name:
                    break
            icon = QIcon(name) if name.startswith("/") else QIcon.fromTheme(name or "application-x-executable")
            if icon.isNull() and name:
                icon = QIcon(AppIcons.find(name, side, dirs))
            pixmap = icon.pixmap(side, side)
            image = pixmap.toImage().convertToFormat(QImage.Format.Format_ARGB32_Premultiplied)
            if image.isNull():
                image = QImage(side, side, QImage.Format.Format_ARGB32_Premultiplied)
                image.fill(Qt.GlobalColor.transparent)
            return image

    class Backend(QObject):
        previewReady = pyqtSignal(str)

        def __init__(self):
            super().__init__()
            self.preview_count = 0
            self.preview_lock = threading.Lock()

        @pyqtSlot(result=str)
        def load(self):
            problems = []
            try:
                state = load_state(problems)
            except Exception as error:
                # Never leave the window empty: fall back to the templates and say why.
                problems.append(str(error))
                state = {"suggest_langs": "", "config": read_toml(asset("config-template.toml")),
                         "layout": read_toml(asset("layout-template.toml")), "keys": []}
            return json.dumps({
                "state": state,
                "problem": (_("Archivo dañado, se cargó la plantilla: ") + "; ".join(problems)) if problems else "",
                "meta": {
                    "lang": LANG,
                    "types": TYPE_LABELS,
                    "toggles": TOGGLES,
                    "icons": sorted(p.stem for p in directory.glob("*.svg")) if directory else [],
                },
            })

        @pyqtSlot(str, result=str)
        def tr(self, text):
            return _(text)

        @pyqtSlot(str, result=str)
        def save(self, body):
            try:
                return save_state(json.loads(body)) or ""
            except Exception as error:
                return _("No se pudo guardar: ") + str(error)

        @pyqtSlot(str, result=str)
        def validateKey(self, body):
            try:
                return validate_key_entry(json.loads(body)) or ""
            except Exception as error:
                return str(error)

        @pyqtSlot(result=str)
        def restore(self):
            try:
                restore_defaults()
            except Exception as error:
                print(error, file=sys.stderr)
            return self.load()

        @pyqtSlot(result=str)
        def apps(self):
            try:
                return json.dumps(desktop_apps())
            except Exception as error:
                print(error, file=sys.stderr)
                return "[]"

        @pyqtSlot(str)
        def touchIdPreview(self, body):
            """Renders the Touch ID prompt (six looks, four states) off the GUI thread; the result arrives as previewReady(json)."""
            self.preview_count += 1
            threading.Thread(target=self._render_preview, args=(body, self.preview_count), daemon=True).start()

        def _render_preview(self, body, seq):
            with self.preview_lock:
                if seq != self.preview_count:  # a newer request replaced this one
                    return
                try:
                    cache = HOME / ".cache/touchbar-plus"
                    cache.mkdir(parents=True, exist_ok=True)
                    prefix = cache / f"tid{seq}"
                    config = cache / "preview-config.toml"
                    config.write_text(dump_flat(json.loads(body)), encoding="utf-8")
                    result = subprocess.run([str(DAEMON), "--snapshot-touchid", str(prefix)], capture_output=True, text=True,
                                            timeout=20, env=dict(os.environ, KAIT2EN_TOUCHBAR_CONFIG=str(config)))
                    if result.returncode != 0:
                        answer = {"error": (result.stderr or result.stdout).strip()}
                    else:
                        for old in cache.glob("tid*-*.png"):
                            if not old.name.startswith(f"tid{seq}-"):
                                old.unlink(missing_ok=True)
                        answer = {"prefix": str(prefix), "url": QUrl.fromLocalFile(str(prefix)).toString()}
                except Exception as error:
                    answer = {"error": str(error)}
            answer["seq"] = seq
            self.previewReady.emit(json.dumps(answer))

        @pyqtSlot(result=str)
        def testNotice(self):
            try:
                subprocess.run(["notify-send", "-a", "Touch Bar Plus", _("Aviso de prueba"), _("Si lo ve en la barra, funciona")],
                               check=True, capture_output=True, text=True, timeout=5)
            except (OSError, subprocess.SubprocessError) as error:
                return str(getattr(error, "stderr", "") or error)
            return ""

    os.environ.setdefault("QT_QUICK_CONTROLS_STYLE", "Basic")
    app = QGuiApplication(sys.argv)
    app.setApplicationName("Touch Bar Plus")
    app.setDesktopFileName("org.kait2en.TouchbarPlus")
    engine = QQmlApplicationEngine()
    provider, backend = Lucide(), Backend()
    engine.addImageProvider("lucide", provider)
    engine.addImageProvider("appicon", AppIcons())
    engine.rootContext().setContextProperty("backend", backend)
    qml = Path(os.environ.get("TBP_QML") or next((b / "qml" for b in (ROOT, HOME / ".local/share/touchbar-plus") if (b / "qml/Main.qml").exists()), ROOT / "qml"))
    engine.addImportPath(str(qml))
    engine.warnings.connect(lambda items: [print(item.toString(), file=sys.stderr) for item in items])
    engine.load(QUrl.fromLocalFile(str(qml / "Main.qml")))
    if not engine.rootObjects():
        return 1
    window = engine.rootObjects()[0]
    prefix = os.environ.get("TBP_SHOT")
    if prefix:
        pages = ["barra", "general", "widgets", "teclas", "touchid"]

        def shoot():
            if not pages:
                app.quit()
                return
            name = pages.pop(0)
            window.setProperty("page", ["barra", "general", "widgets", "teclas", "touchid"].index(name))
            QTimer.singleShot(700, lambda: (window.grabWindow().save(f"{prefix}-{name}.png"), shoot()))

        QTimer.singleShot(1500, shoot)
    elif os.environ.get("TBP_SCRIPT"):
        # Development hook: runs a script with the live window, e.g. to simulate drags.
        code = Path(os.environ["TBP_SCRIPT"]).read_text(encoding="utf-8")
        QTimer.singleShot(1500, lambda: exec(code, {"app": app, "window": window, "QTimer": QTimer}))
    elif os.environ.get("TBP_SMOKE"):
        QTimer.singleShot(2000, app.quit)
    code = app.exec()
    # Tear the QML tree down while the backend still exists, or its bindings log errors.
    engine.deleteLater()
    app.sendPostedEvents(None, 52)  # QEvent.Type.DeferredDelete
    return code


if __name__ == "__main__":
    sys.exit(main())
