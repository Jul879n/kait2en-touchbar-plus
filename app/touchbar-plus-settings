def detect_language():
    """`language` of config.toml (auto, es, en); auto follows the locale."""
    try:
        setting = tomllib.loads((CONFIG_DIR / "config.toml").read_text(encoding="utf-8")).get("language", "auto")
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError):
        setting = "auto"
    if setting in ("es", "en"):
        return setting
    locale = os.environ.get("LC_ALL") or os.environ.get("LC_MESSAGES") or os.environ.get("LANG") or ""
    return "en" if locale.startswith("en") else "es"


