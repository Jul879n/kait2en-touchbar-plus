# --- TOML ----------------------------------------------------------------

def tv(value):
    """One TOML value on a single line."""
    if value is None:
        raise ValueError("null value in the settings")
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, str):
        return json.dumps(value, ensure_ascii=False)
    if isinstance(value, list):
        return "[ " + ", ".join(tv(v) for v in value) + " ]" if value else "[]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{k} = {tv(v)}" for k, v in value.items()) + " }"
    raise ValueError(f"unsupported value {value!r}")


def dump_flat(data, header=""):
    lines = [header] if header else []
    lines += [f"{key} = {tv(value)}" for key, value in data.items()]
    return "\n".join(lines) + "\n"


def dump_layout(data):
    out = [
        "# Touch Bar Plus: disposición. Generado por la app «Touch Bar Plus».",
        f"strip = {tv(data['strip'])}",
        f"default = {tv(data['default'])}",
    ]
    for profile in data.get("profile", []):
        out += [
            "",
            "[[profile]]",
            f"name = {tv(profile['name'])}",
            f"apps = {tv(profile.get('apps', []))}",
            f"items = {tv(profile.get('items', []))}",
        ]
    for table in ("clock", "weather", "pomodoro", "now_playing", "controls"):
        out += ["", f"[{table}]"] + [f"{k} = {tv(v)}" for k, v in data[table].items()]
    out += ["", "[emoji]", f"favorites = {tv(data['emoji'].get('favorites', []))}"]
    return "\n".join(out) + "\n"


def dump_keys(keys):
    out = ["# Teclas personales de la tercera fila. Generado por «Touch Bar Plus»."]
    for key in keys:
        # The daemon only accepts these three fields in keys.toml.
        out += ["", "[[key]]"] + [f"{k} = {tv(v)}" for k, v in key.items() if k in ("label", "send", "run")]
    return "\n".join(out) + "\n"


def asset(name):
    for base in (ROOT.parent / "daemon", ROOT / "share", HOME / ".local/share/touchbar-plus"):
        if (base / name).exists():
            return base / name
    raise FileNotFoundError(name)


def read_toml(path, fallback=None, problems=None):
    """TOML file as a dict. Missing or broken files give the template (or {}); a broken one is reported in `problems`."""
    try:
        return tomllib.loads(Path(path).read_text(encoding="utf-8"))
    except FileNotFoundError:
        pass
    except (OSError, UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        if problems is None:
            raise
        problems.append(f"{Path(path).name}: {error}")
    return tomllib.loads(asset(fallback).read_text(encoding="utf-8")) if fallback else {}


def load_state(problems=None):
    layout = read_toml(CONFIG_DIR / "layout.toml", "layout-template.toml", problems)
    template = tomllib.loads(asset("layout-template.toml").read_text(encoding="utf-8"))
    for key in ("strip", "default"):
        layout.setdefault(key, template[key])
    for table in ("clock", "weather", "pomodoro", "now_playing", "controls"):
        if not isinstance(layout.get(table), dict):
            layout[table] = {}
        for key, value in template[table].items():
            layout[table].setdefault(key, value)
    if not isinstance(layout.get("emoji"), dict):
        layout["emoji"] = {}
    layout["emoji"].setdefault("favorites", [])  # a bare [emoji] means no favorites
    layout.setdefault("profile", [])
    keys_path = CONFIG_DIR / "keys.toml"
    keys_path = keys_path if keys_path.exists() else LEGACY_KEYS
    return {
        "suggest_langs": get_suggest_langs(),
        "config": read_toml(CONFIG_DIR / "config.toml", "config-template.toml", problems),
        "layout": layout,
        "keys": read_toml(keys_path, None, problems).get("key", []),
    }


BOOSTER = "org.freedesktop.ibus.engine.typing-booster:/org/freedesktop/ibus/engine/typing-booster/"


def get_suggest_langs():
    try:
        out = subprocess.run(["gsettings", "get", BOOSTER, "dictionary"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.strip().strip("'")


def check_suggest_langs(value):
    """Error text for dictionaries that are not installed, or None."""
    for code in (c.strip() for c in value.split(",") if c.strip()):
        if not any((Path(d) / f"{code}.dic").exists() for d in ("/usr/share/hunspell", "/usr/share/myspell")):
            return _("Diccionario no instalado: ") + code
    return None


def validate_key_entry(entry):
    """Returns an error text for a personal key or None."""
    label = entry.get("label", "")
    if not entry.get("icon") and not (1 <= len(label) <= 12 and label.isascii()):
        return _("La etiqueta debe tener 1 a 12 caracteres ASCII (o elegir un ícono).")
    if label and (len(label) > 12 or not label.isascii()):
        return _("La etiqueta debe tener 1 a 12 caracteres ASCII.")
    if bool(entry.get("send")) == bool(entry.get("run")):
        return _("Indique exactamente un atajo o un comando.")
    return None


def save_state(state):
    """Writes through temporary files, checks them with the daemon and only
    then replaces the live ones. Returns an error text or None."""
    langs = state.get("suggest_langs", "")
    if langs != get_suggest_langs():  # only a changed value needs its dictionaries installed
        problem = check_suggest_langs(langs)
        if problem:
            return problem
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    targets = {
        "config.toml": dump_flat(state["config"], "# Touch Bar Plus. Generado por la app «Touch Bar Plus»."),
        "layout.toml": dump_layout(state["layout"]),
        "keys.toml": dump_keys(state["keys"]),
    }
    temps = {}
    try:
        for name, body in targets.items():
            temp = CONFIG_DIR / f"{name}.new.{os.getpid()}"
            with open(temp, "w", encoding="utf-8") as handle:
                handle.write(body)
                handle.flush()
                os.fsync(handle.fileno())
            temps[name] = temp
        env = dict(
            os.environ,
            KAIT2EN_TOUCHBAR_CONFIG=str(temps["config.toml"]),
            KAIT2EN_TOUCHBAR_LAYOUT=str(temps["layout.toml"]),
            KAIT2EN_TOUCHBAR_KEYS=str(temps["keys.toml"]),
        )
        result = subprocess.run([str(DAEMON), "--check-config"], env=env, capture_output=True, text=True, timeout=20)
        output = (result.stdout + result.stderr).strip()
        if result.returncode != 0 or output != "ok":
            return output or _("El daemon rechazó la configuración.")
        for name, temp in temps.items():
            os.replace(temp, CONFIG_DIR / name)
        temps = {}
        warnings = []
        if langs != get_suggest_langs():
            booster = subprocess.run(["gsettings", "set", BOOSTER, "dictionary", langs], capture_output=True, text=True, timeout=10)
            if booster.returncode != 0:
                warnings.append(_("Guardado, pero no se cambió el diccionario de sugerencias: ") + (booster.stderr or booster.stdout).strip())
        restart = subprocess.run(["systemctl", "--user", "restart", SERVICE], capture_output=True, text=True, timeout=30)
        if restart.returncode != 0:
            warnings.append(_("Guardado, pero el servicio no se reinició: ") + ((restart.stderr or restart.stdout).strip() or f"código {restart.returncode}"))
        return " ".join(warnings) or None
    except (OSError, subprocess.SubprocessError) as error:
        return str(error)
    finally:
        for temp in temps.values():
            temp.unlink(missing_ok=True)


def restore_defaults():
    for name in ("config.toml", "layout.toml"):
        (CONFIG_DIR / name).unlink(missing_ok=True)
    subprocess.run(["systemctl", "--user", "restart", SERVICE], check=False, capture_output=True, timeout=30)


def icon_dir():
